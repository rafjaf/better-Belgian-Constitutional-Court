{
  "manifest_version": 3,
  "name": "Better Belgian Constitutional Court",
  "version": "1.0.4",
  "description": "Display judgments of the Belgian Constitutional Court with PDF.js and add automatic reference extraction when copying text.",
  "host_permissions": [
    "https://nl.const-court.be/public/n/*",
    "https://nl.const-court.be/public/f/*",
    "https://fr.const-court.be/public/f/*",
    "https://fr.const-court.be/public/n/*",
    "https://nl.const-court.be/*/*.pdf",
    "https://fr.const-court.be/*/*.pdf"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://nl.const-court.be/public/n/*",
        "https://nl.const-court.be/public/f/*",
        "https://fr.const-court.be/public/f/*",
        "https://fr.const-court.be/public/n/*",
        "https://nl.const-court.be/*/*.pdf",
        "https://fr.const-court.be/*/*.pdf"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "web/*",
        "build/*",
        "viewer-inject.js",
        "test-bpoint.html"
      ],
      "matches": [
        "https://nl.const-court.be/*",
        "https://fr.const-court.be/*",
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Better Belgian Constitutional Court"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{d0c96cdb-7d2c-4e6c-9e6f-1a9f6f1d4a5a}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
